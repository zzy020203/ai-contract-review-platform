# 复制为 .env 后按需修改。全部省略也能启动：默认 SQLite + 本地 Redis。

# --- 数据库 ---
# 默认使用 storage/contract.db（SQLite）。使用 PostgreSQL 时取消注释：
# DATABASE_URL=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/contract

# --- Redis（Celery 任务队列 / SSE 事件，必填）---
REDIS_URL=redis://127.0.0.1:6379/0

# --- 模型服务（OpenAI 兼容协议）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat

# --- 安全（生产环境务必修改）---
JWT_SECRET=change-me-in-production

# --- 向量检索 ---
# 留空使用 milvus-lite 本地文件；生产环境填写 Milvus 服务地址，如 http://127.0.0.1:19530
# MILVUS_URI=
